# Public Supabase project keys (Project Settings > API) — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL da API Express (server/). Deixe VAZIO/ausente em produção: sem essa variável
# o código usa o principal (servidorcaseiro) e cai sozinho no Render se ele sumir.
# Definir isso em produção DESLIGA esse padrão e fixa no host que você escrever.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this site once deployed (used for og:image resolution)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL segment that serves the admin login (app/estudio internally). Change this per
# deployment to something unguessable — the literal "estudio" path stops responding
# once this differs from it (see proxy.js). Not a real access control by itself
# (Supabase auth is), just keeps the login page from sitting at a predictable path.
NEXT_PUBLIC_ADMIN_PATH=estudio
