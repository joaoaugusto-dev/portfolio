# Public Supabase project keys (Project Settings > API) — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# API principal (server/). OBRIGATÓRIA — sem ela o build falha de propósito, em vez
# de gerar um site que chama "undefined/api/..." e quebra calado.
#   dev:  http://localhost:4000
#   prod: https://api-portfolio.servidorcaseiro.online
NEXT_PUBLIC_API_URL=http://localhost:4000

# API reserva. Opcional: se a principal responder erro de rede ou 5xx, as LEITURAS
# vão pra cá sozinhas. Gravação nunca cai pra reserva — os dois hosts falam com o
# mesmo banco, e repetir um POST que talvez já tenha sido processado duplicaria o
# registro.
#
# Em dev deixe COMENTADA: sem reserva, um server local fora do ar dá erro na cara
# em vez de te mostrar os dados de produção como se fossem os seus.
#   prod: https://joaoaugusto-portfolio-api.onrender.com
# NEXT_PUBLIC_API_URL_2=

# Public URL of this site once deployed (used for og:image resolution)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL segment that serves the admin login (app/estudio internally). Change this per
# deployment to something unguessable — the literal "estudio" path stops responding
# once this differs from it (see proxy.js). Not a real access control by itself
# (Supabase auth is), just keeps the login page from sitting at a predictable path.
NEXT_PUBLIC_ADMIN_PATH=estudio
