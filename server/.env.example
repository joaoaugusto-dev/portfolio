# Postgres. No hosting vem injetado ao ligar o banco "portfolio" ao app.
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/portfolio
# DB_SSL=true   # só pra banco remoto que exija SSL

# Bucket do hosting. Injetados ao ligar o bucket "portfolio" ao app.
# Pra rodar local, copie url e token de `hosting_buckets list`.
BUCKET_URL=http://<ip-do-servidor>:8430
BUCKET_NAME=portfolio
BUCKET_TOKEN=xxxx

# Assina o login do painel. 32+ caracteres aleatórios:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
JWT_SECRET=

# Teto do bucket em GB (padrão 2). Ver lib/storageCap.js.
# STORAGE_CAP_GB=2

# Origens que podem chamar esta API, separadas por vírgula (localhost já passa sozinho)
CORS_ORIGIN=https://www.joaoaugusto.dev,https://joaoaugusto.dev

PORT=4000
