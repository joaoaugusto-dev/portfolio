# Supabase Postgres connection — use the POOLER string (IPv4), not the direct "db.xxx" host (IPv6-only,
# often unreachable). Get it from: Project Settings > Database > Connect > "Transaction pooler" tab.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Project Settings > API — still needed even though Storage moved to
# R2 below: requireAuth verifies the admin's session JWT via supabase.auth.getUser().
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare dashboard > R2 > Manage API Tokens (create a token with read+write
# on this bucket). Bucket is private — everything is proxied through this API
# (files.js /raw/*, covers.js /:key), the R2 URL never reaches the browser.
# The bucket also needs a CORS policy allowing PUT from your site's origin(s),
# since large-file uploads go browser -> R2 directly (see files.js /presign).
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET=portfolio

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,https://your-portfolio.vercel.app

# Comma-separated list of emails allowed to authenticate as admin (requireAuth).
# Without this, ANY account able to sign up on your Supabase project would pass a
# valid-JWT check and get full admin access.
ADMIN_EMAILS=you@example.com

PORT=4000
